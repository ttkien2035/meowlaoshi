{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeowLaoshi",
  "mainBinaryName": "meowlaoshi",
  "version": "1.1.0",
  "identifier": "com.ttkien2035.meowlaoshi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MeowLaoshi",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 420,
        "center": true,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 14
        },
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc://localhost wss: https:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "frameworks": [],
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 175
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 175
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzOEUxQzcyMTVFNEYyQkMKUldTODh1UVZjaHlPdzYwM0ZUTmdXL2NPNmY2bHUzMmJpRmRQbWthWE0rUU9vZWlwU05ucDN2eVoK",
      "endpoints": [
        "https://github.com/ttkien2035/meowlaoshi/releases/latest/download/latest.json"
      ]
    }
  }
}
